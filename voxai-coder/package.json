{
  "name": "voxai-coder",
  "version": "0.2.87",
  "description": "VoxAI Coder — Forge-style desktop coding agent. Own Node agent loop, OpenRouter models, no external agent binary.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/regression-protocol.js && node test/regression-tools.js && node test/regression-renderer.js && node test/regression-sessions.js && node test/regression-refit.js && node test/regression-hf.js && node test/regression-cost.js && node test/regression-direct.js && node scripts/auto-battery.js --quiet",
    "pack": "electron-builder --dir",
    "predist": "node scripts/csp.js && node scripts/build-uia.js --strict && node scripts/clean-release.js",
    "dist": "electron-builder --publish never",
    "predist:linux": "node scripts/csp.js && node scripts/clean-release.js",
    "dist:linux": "electron-builder --linux --publish never && node scripts/linux-sh.js",
    "icon": "electron scripts/make-icon.js",
    "release-key": "node scripts/release-key.js",
    "release": "node scripts/release.js",
    "prestart": "node scripts/csp.js && node scripts/build-uia.js",
    "predev": "node scripts/csp.js && node scripts/build-uia.js",
    "pretest": "node scripts/csp.js",
    "predist:mac": "node scripts/csp.js && node scripts/clean-release.js",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "author": "VoxAI",
  "homepage": "https://coderook.com",
  "desktopName": "voxai-coder.desktop",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.vox.coder",
    "productName": "VoxAI Coder",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "resources/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**",
      "resources/uia/**",
      "node_modules/node-pty/**"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://api.coderook.com/v1/public/projects/batty-251/voxai-coder/updates"
      }
    ],
    "nsis": {
      "artifactName": "VoxAI-Coder-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "VoxAI-Coder-${version}-portable.${ext}"
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Development",
      "executableName": "voxai-coder",
      "synopsis": "Desktop coding agent for OpenRouter and local models",
      "target": [
        "AppImage"
      ],
      "artifactName": "VoxAI-Coder-${version}.${ext}"
    },
    "npmRebuild": false,
    "mac": {
      "icon": "resources/icon-1024.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "VoxAI Coder uses the microphone only when you press the mic button to dictate a message.",
        "NSAppleEventsUsageDescription": "VoxAI Coder controls other apps only when you ask it to, and asks before each action."
      },
      "artifactName": "VoxAI-Coder-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "VoxAI-Coder-${version}-mac-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.1",
    "node-pty": "^1.1.0"
  }
}
