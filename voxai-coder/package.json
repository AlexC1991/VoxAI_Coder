{
  "name": "voxai-coder",
  "version": "0.2.49",
  "description": "VoxAI Coder — Forge-style desktop coding agent. Own Node agent loop, OpenRouter models, no external agent binary.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/regression-protocol.js && node test/regression-tools.js && node test/regression-renderer.js && node test/regression-sessions.js && node test/regression-refit.js",
    "pack": "electron-builder --dir",
    "predist": "node scripts/csp.js && node scripts/build-uia.js --strict && node scripts/clean-release.js",
    "dist": "electron-builder --publish never",
    "icon": "electron scripts/make-icon.js",
    "release-key": "node scripts/release-key.js",
    "release": "node scripts/release.js",
    "prestart": "node scripts/csp.js && node scripts/build-uia.js",
    "predev": "node scripts/csp.js && node scripts/build-uia.js",
    "pretest": "node scripts/csp.js"
  },
  "author": "VoxAI",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.vox.coder",
    "productName": "VoxAI Coder",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "resources/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**",
      "resources/uia/**"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://api.coderook.com/v1/public/projects/batty-251/voxai-coder-releases/updates"
      }
    ],
    "nsis": {
      "artifactName": "VoxAI-Coder-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "VoxAI-Coder-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.1"
  }
}
